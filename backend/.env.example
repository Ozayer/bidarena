SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only (config.settings.prod) - your Render URL, e.g. https://bidarena.onrender.com
CSRF_TRUSTED_ORIGINS=

DB_NAME=bidarena_dev
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Production only - Neon requires SSL: set to "require"
DB_SSLMODE=prefer

REDIS_URL=redis://localhost:6379/0

TIME_ZONE=Europe/Helsinki

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used to build absolute media URLs in WebSocket broadcasts. In production,
# set to your Render URL (same value as one of the ALLOWED_HOSTS, with scheme).
SITE_BASE_URL=http://localhost:8000

# Production only - player photos/team logos/tournament covers are stored on
# Cloudinary instead of local disk when these are set (leave blank for local
# dev; local filesystem storage is used automatically). From the Cloudinary
# dashboard's "API Keys" section.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
